{
  "name": "destiny-explained-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Episode1 out/episode1.mp4 --codec=h264 --pixel-format=yuv420p --concurrency=2",
    "still": "remotion still src/index.ts Episode1 out/frame.png --frame=150 --image-format=png",
    "typecheck": "tsc --noEmit",
    "browser:ensure": "remotion browser ensure",
    "still:voxel": "remotion still src/index.ts VoxelResurrection out/voxel-frame.png --frame=165 --image-format=png --gl=swangle",
    "render:voxel": "remotion render src/index.ts VoxelResurrection out/voxel-resurrection.mp4 --codec=h264 --pixel-format=yuv420p --concurrency=1 --gl=swangle",
    "test:voxel": "node --experimental-strip-types --test tests/voxel-timeline.test.mjs",
    "validate:episode": "node --experimental-strip-types scripts/episode.mjs validate",
    "render:episode": "node --experimental-strip-types scripts/episode.mjs render",
    "render:episode:test": "node --experimental-strip-types scripts/episode.mjs render --preview --frames=1140-1319",
    "still:episode": "remotion still src/index.ts VoxelEpisode out/episode-002-traveler.png --frame=1310 --image-format=png --gl=swangle",
    "test:episode": "node --experimental-strip-types --test tests/episode.test.mjs",
    "narrate:episode": "python scripts/narration.py",
    "render:episode:voiced": "node --experimental-strip-types scripts/episode.mjs render out/traveler_episode_002-ready.json",
    "test:narration": "python -m unittest discover -s tests -p \"test_narration.py\"",
    "verify:narration": "python scripts/verify_narration.py",
    "prepare:cinematic": "node --experimental-strip-types scripts/prepare-cinematic.mjs",
    "render:cinematic": "node --experimental-strip-types scripts/episode.mjs render out/traveler_episode_002_cinematic-ready.json",
    "test:cinematic": "node --experimental-strip-types --test tests/cinematic.test.mjs",
    "verify:cinematic": "python scripts/verify_narration.py --episode out/traveler_episode_002_cinematic-ready.json --video out/episode-002-traveler-cinematic.mp4",
    "still:motion": "remotion still src/index.ts VoxelMotionLab out/motion-lab.png --frame=390 --image-format=png --gl=swangle",
    "editor:build": "node scripts/build-editor.mjs",
    "editor:check": "node scripts/build-editor.mjs --check",
    "test:editor": "node --experimental-strip-types --test ../editor/model.test.mjs",
    "test:editor:browser": "node ../editor/browser.test.cjs",
    "test:library": "node --experimental-strip-types --test tests/library.test.mjs",
    "render:worlds:preview": "node --experimental-strip-types scripts/episode.mjs render episodes/voxel_worlds_demo.json --preview",
    "narrate:worlds": "python scripts/narration.py episodes/voxel_worlds_demo.json",
    "render:worlds": "node --experimental-strip-types scripts/episode.mjs render out/voxel_worlds_demo-ready.json",
    "test:atlas": "node --experimental-strip-types --test tests/atlas.test.mjs",
    "test:atlas:import": "python -m unittest discover -s tests -p \"test_manifest_import.py\"",
    "narrate:atlas": "python scripts/narration.py episodes/atlas_demo.json",
    "render:atlas": "node --experimental-strip-types scripts/episode.mjs render out/atlas_demo-ready.json",
    "render:atlas:preview": "node --experimental-strip-types scripts/episode.mjs render episodes/atlas_demo.json --preview",
    "report:atlas": "node --experimental-strip-types scripts/atlas-report.mjs",
    "test:living": "node --experimental-strip-types --test tests/living.test.mjs",
    "test:living:browser": "node ../editor/living.browser.test.cjs",
    "narrate:living": "python scripts/narration.py episodes/living_europa.json",
    "render:living": "node --experimental-strip-types scripts/episode.mjs render out/living_europa-ready.json",
    "verify:living:render": "node scripts/verify-living-render.mjs",
    "test:editor:offline": "node ../editor/offline.browser.test.cjs",
    "test:hybrid": "node --experimental-strip-types --test tests/hybrid.test.mjs",
    "test:hybrid:browser": "node ../editor/hybrid.browser.test.cjs",
    "narrate:hybrid": "python scripts/narration.py episodes/hybrid_riis.json",
    "render:hybrid": "node --experimental-strip-types scripts/episode.mjs render out/hybrid_riis-ready.json",
    "verify:hybrid:render": "node scripts/verify-hybrid-render.mjs",
    "test:polish": "node --experimental-strip-types --test tests/polish.test.mjs",
    "test:polish:browser": "node ../editor/polish.browser.test.cjs",
    "prepare:polish:comparison": "node --experimental-strip-types scripts/prepare-riis-comparison.mjs",
    "render:polish:comparison": "python scripts/render-riis-comparison.py",
    "verify:polish:render": "node scripts/verify-polish-render.mjs",
    "test:animation": "node --experimental-strip-types --test tests/animation.test.mjs",
    "test:animation:browser": "node ../editor/animation.browser.test.cjs",
    "prepare:animation": "node --experimental-strip-types scripts/prepare-animation-demo.mjs",
    "verify:animation:render": "node scripts/verify-animation-render.mjs",
    "benchmark:animation": "python scripts/benchmark-animation.py",
    "export:blender": "node --experimental-strip-types blender/export.mjs",
    "test:blender": "node --experimental-strip-types --test blender/tests/export.test.mjs",
    "test:blender:python": "python -m unittest discover -s blender/tests",
    "test:blender:import": "blender --background --factory-startup --python-exit-code 1 --python blender/tests/blender_check.py -- blender/examples/riis-frame-210.json"
  },
  "dependencies": {
    "@react-three/fiber": "8.18.0",
    "@remotion/cli": "4.0.541",
    "@remotion/player": "4.0.541",
    "@remotion/three": "4.0.541",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.541",
    "three": "0.170.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.170.0",
    "esbuild": "0.28.1",
    "playwright-core": "1.58.2",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": "22.23.4",
    "npm": ">=10 <12"
  }
}
