          "actor": "ghost",
          "animation": "hover"
        },
        {
          "actor": "ghost",
          "animation": "scan"
        }
      ],
      "effects": [
        "light-particles"
      ],
      "narration": "Afterward, the Traveler released Ghosts: small, independent companions that search for people they can bring back as Lightbearers. Some become Guardians, defenders of the Last City."
    },
    {
      "id": "scene-05",
      "startFrame": 1200,
      "durationFrames": 300,
      "location": "the-tower",
      "camera": "medium-guardian",
