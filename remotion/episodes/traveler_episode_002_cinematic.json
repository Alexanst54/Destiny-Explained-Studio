          "animation": "resurrect"
        },
        {
          "actor": "ghost",
          "animation": "hover"
        }
      ],
      "effects": [
        "resurrection-beam",
        "voxel-particles"
      ],
      "narration": "With their Ghosts, Guardians can wield the Light and return from death, though that power has limits, and a Ghost can be destroyed."
    },
    {
      "id": "scene-06",
      "startFrame": 1500,
      "durationFrames": 300,
      "location": "the-tower",
      "camera": "wide-pullback",
