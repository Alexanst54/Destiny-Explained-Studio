      ],
      "effects": [
        "golden-glow"
      ],
      "narration": "Long ago, the Traveler arrived in our solar system. Its presence helped humanity enter a Golden Age of discovery, technology, and longer lives."
    },
    {
      "id": "scene-03",
      "startFrame": 540,
      "durationFrames": 300,
      "location": "the-tower",
      "camera": "push-in-sky",
