        {
          "actor": "guardian",
          "animation": "look-up"
        }
      ],
      "effects": [
        "sky-darken",
        "distant-lightning"
      ],
      "narration": "Then came the Collapse. A terrible catastrophe devastated civilization. The Traveler remained on Earth, while humanity struggled to survive."
    },
    {
      "id": "scene-04",
      "startFrame": 840,
      "durationFrames": 360,
      "location": "the-tower",
      "camera": "close-up-ghost",
